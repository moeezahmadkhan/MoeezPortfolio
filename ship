#!/usr/bin/env bash
#
# Puts the site live, and puts the same commit on GitHub.
#
# Pushing to GitHub deploys NOTHING here — Actions and the Vercel GitHub App are
# locked to the EMU account — so the push and the deploy are two separate acts
# that have to be done together or the live site and the remote drift apart.
# The gates run first, because the whole point of having them is that nothing
# ships past them.
#
# One command: gates, then push, then deploy. What is live and what is on
# GitHub end up the same commit, which is the whole point of doing both here.
#
#   ./ship                 gates, push to `both`, deploy to production
#   ./ship --commit "msg"  commit every tracked change first, then the above
#   ./ship --no-push       deploy without pushing (the live site will be ahead)
#   ./ship --quick         skip the browser gates (unit tests + build still run)
#   ./ship --preview       deploy to a preview URL instead of production
#   ./ship --yes           do not stop to confirm
#   ./ship --gates-only    run every gate and stop; push and deploy nothing
#
# Exit codes: 0 shipped (or gates passed under --gates-only), 1 a gate failed,
# the push failed, or the deploy was refused.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP="$ROOT/frontend"

# One pinned port for every browser gate.
#
# The tools disagree by default — check_scramble.mjs reads $URL and defaults to
# 4173, the others read $SHOOT_URL and default to 4174 — and a preview server
# left over from another session takes whichever it finds free, so a gate can
# silently measure a DIFFERENT build than the one about to ship. Pinning it and
# exporting both names removes the guess. --strictPort makes a clash an error
# rather than a quiet reassignment.
PORT=4183
BASE="http://localhost:$PORT"

QUICK=0
PREVIEW=0
ASSUME_YES=0
GATES_ONLY=0
PUSH=1
COMMIT_MSG=""

while [[ $# -gt 0 ]]; do
  arg="$1"
  case "$arg" in
    --quick)      QUICK=1 ;;
    --preview)    PREVIEW=1 ;;
    --yes|-y)     ASSUME_YES=1 ;;
    --gates-only) GATES_ONLY=1 ;;
    --no-push)    PUSH=0 ;;
    --commit)
      shift
      [[ $# -gt 0 ]] || { echo "ship: --commit needs a message" >&2; exit 1; }
      COMMIT_MSG="$1"
      ;;
    # The header block IS the help, so the two cannot drift apart: print the
    # comment lines from line 3 and stop at the first line that is not one.
    -h|--help)    awk 'NR>=3 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "ship: unknown option '$arg' (try --help)" >&2; exit 1 ;;
  esac
  shift
done

# The remote that fans out to both GitHub accounts. `git remote -v` shows it
# with two push URLs — github.com/moeezahmadkhan and github-new/moeezahmadkhangit
# — so one push keeps the pair in step. Override with SHIP_REMOTE=origin.
REMOTE="${SHIP_REMOTE:-both}"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
fail() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
ok()   { printf '\033[32m✓ %s\033[0m\n' "$*"; }

PREVIEW_PID=""

# Kill the whole process GROUP, not the pid.
#
# `npm run preview` is a shell that spawns vite as a child. Killing the npm pid
# reaps npm and orphans vite, which keeps the port bound — verified: after a
# clean run the script had exited and :4183 was still LISTEN on a stray node.
# The next run would then die on --strictPort, or worse, a later run would
# measure the server this one left behind. `setsid` below makes the npm process
# a group leader (so PGID == PID) and the negative pid kills everything in it.
cleanup() {
  [[ -n "$PREVIEW_PID" ]] || return 0
  kill -- "-$PREVIEW_PID" 2>/dev/null || kill "$PREVIEW_PID" 2>/dev/null || true
  wait "$PREVIEW_PID" 2>/dev/null || true
  PREVIEW_PID=""
}
trap cleanup EXIT INT TERM

cd "$APP"

# --- what is about to ship -------------------------------------------------

SHA="$(git rev-parse --short HEAD)"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
DIRTY="$(git status --porcelain)"

bold "Shipping $BRANCH @ $SHA"

if [[ -n "$DIRTY" && -z "$COMMIT_MSG" ]]; then
  # The asymmetry that matters, stated plainly: `vercel --prod` uploads the
  # WORKING TREE, and `git push` sends only what is committed. So uncommitted
  # work goes live and does not go to GitHub — the live site ends up carrying
  # code that exists on no remote. A warning rather than a refusal, because the
  # repo routinely carries an unrelated modified file from a parallel session;
  # `--commit "msg"` is the way to close the gap.
  printf '\033[33m! uncommitted changes — these DEPLOY but do NOT push:\033[0m\n'
  echo "$DIRTY" | sed 's/^/    /'
  printf '\033[33m  (use --commit "msg" to commit them first)\033[0m\n'
fi

if ! git diff --quiet HEAD "@{u}" 2>/dev/null; then
  printf '\033[33m! HEAD differs from its upstream — the live site will not match the remote\033[0m\n'
fi

# --- gates -----------------------------------------------------------------

bold "Unit tests and types"
npm test
npx tsc -b
ok "tests and types"

bold "Build"
npm run build
ok "build"

if [[ "$QUICK" -eq 1 ]]; then
  printf '\033[33m! --quick: browser gates skipped (motion, contrast, stations, scramble, csp)\033[0m\n'
else
  bold "Browser gates on :$PORT"
  setsid npm run preview -- --port "$PORT" --strictPort >/tmp/ship-preview.log 2>&1 &
  PREVIEW_PID=$!

  for _ in $(seq 1 40); do
    if curl -fsS -o /dev/null "$BASE/"; then break; fi
    if ! kill -0 "$PREVIEW_PID" 2>/dev/null; then
      cat /tmp/ship-preview.log >&2
      fail "preview server exited before it served anything"
    fi
    sleep 0.25
  done
  curl -fsS -o /dev/null "$BASE/" || { cat /tmp/ship-preview.log >&2; fail "preview never came up on $BASE"; }

  # Both names, because the tools disagree about which one they read.
  export SHOOT_URL="$BASE/"
  export URL="$BASE"

  npm run check:motion
  npm run check:contrast
  npm run check:stations
  npm run check:scramble
  # Serves dist/ through vercel.json's real headers on a port of its own, so it
  # needs no preview and must run regardless.
  npm run check:csp

  cleanup
  # Prove it: a bound port here means the next run dies on --strictPort.
  if command -v ss >/dev/null && ss -ltn 2>/dev/null | grep -q ":$PORT "; then
    fail "preview server survived cleanup and is still bound to :$PORT"
  fi
  ok "browser gates"
fi

# The corpus is committed and the serverless function does no I/O, so a stale
# one ships silently. Rebuilding it must be a no-op; if it is not, src/content/
# changed without `npm run persona` and the bot is about to disagree with the
# page.
bold "Chat corpus"
npm run persona >/dev/null
if ! git diff --quiet -- api/_core/corpus.generated.json; then
  fail "corpus.generated.json is stale — 'npm run persona' changed it. Commit the rebuild, then ship."
fi
ok "corpus matches src/content/"

if [[ "$GATES_ONLY" -eq 1 ]]; then
  bold "--gates-only: everything passed, nothing deployed"
  exit 0
fi

# --- commit and push -------------------------------------------------------
#
# Before the deploy, never after: if the push is going to be rejected — someone
# else pushed, the branch has no upstream, the key is wrong — it is far better
# to find out while the live site is still the old one.

if [[ -n "$COMMIT_MSG" ]]; then
  if [[ -z "$DIRTY" ]]; then
    printf '\033[33m! --commit given but the tree is clean; nothing to commit\033[0m\n'
  else
    bold "Committing"
    # -a: tracked files only. An untracked file is far more often a scratch
    # note or a stray screenshot than something meant to ship, and `git add -A`
    # inside a deploy script is how those reach a public repo.
    git commit -a -m "$COMMIT_MSG"
    SHA="$(git rev-parse --short HEAD)"
    ok "committed $SHA"
    UNTRACKED="$(git ls-files --others --exclude-standard)"
    if [[ -n "$UNTRACKED" ]]; then
      printf '\033[33m! untracked files were NOT committed (add them by hand if they should ship):\033[0m\n'
      echo "$UNTRACKED" | sed 's/^/    /'
    fi
  fi
fi

if [[ "$PUSH" -eq 1 ]]; then
  bold "Pushing $BRANCH to $REMOTE"
  git remote get-url --push "$REMOTE" >/dev/null 2>&1 ||
    fail "no remote named '$REMOTE' (set SHIP_REMOTE, or add it)"
  # -u so a branch that has never been pushed gets its upstream set here rather
  # than failing; on a branch that already has one this is a no-op.
  git push -u "$REMOTE" "$BRANCH" || fail "push failed — nothing has been deployed"
  ok "pushed $BRANCH @ $(git rev-parse --short HEAD)"
else
  printf '\033[33m! --no-push: the live site will be ahead of the remote\033[0m\n'
fi

# --- deploy ----------------------------------------------------------------

if [[ "$ASSUME_YES" -ne 1 ]]; then
  target="production"; [[ "$PREVIEW" -eq 1 ]] && target="a preview URL"
  read -r -p "Deploy $BRANCH @ $SHA to $target? [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]] || fail "not deployed"
fi

bold "Deploying"

# From the REPO ROOT, not from frontend/, and this is the whole trick.
#
# The Vercel project's Root Directory setting is `frontend`, so Vercel resolves
# the app as <cwd>/frontend. Everything above this line runs in frontend/ —
# that is where package.json is — and deploying from there made Vercel look for
# frontend/frontend and fail with:
#
#   Error: The specified Root Directory "frontend" does not exist.
#
# Both the root and frontend/ carry a .vercel link to the same project
# (moeezahmadkhan-com), which is what made this easy to get wrong: the deploy
# STARTS fine from either and only fails once the build resolves the path.
cd "$ROOT"
[[ -f "$ROOT/.vercel/project.json" ]] ||
  fail "no .vercel/project.json at the repo root — run 'npx vercel link' here first"

# --prod is the only difference between a preview and the live site. The project
# is already linked, so this needs no --scope or --name.
if [[ "$PREVIEW" -eq 1 ]]; then
  npx vercel
else
  npx vercel --prod
fi

ok "deployed $BRANCH @ $SHA"
echo
echo "OPENROUTER_API_KEY must be set as a Vercel project env var for /api/chat;"
echo "without it the chat returns its fallback reply. It is never read from here."
