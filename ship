#!/usr/bin/env bash
#
# Puts the site live on Vercel.
#
# Pushing to GitHub deploys nothing — Actions and the Vercel GitHub App are
# locked to the EMU account — so this script is the deploy. It runs the gates
# first, because the whole point of having them is that nothing ships past them.
#
#   ./ship              full gates, then deploy to production
#   ./ship --quick      skip the browser gates (unit tests + build still run)
#   ./ship --preview    deploy to a preview URL instead of production
#   ./ship --yes        do not stop to confirm
#   ./ship --gates-only run every gate and stop; deploy nothing
#
# Exit codes: 0 shipped (or gates passed under --gates-only), 1 a gate failed
# or the deploy was refused.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP="$ROOT/frontend"

# One pinned port for every browser gate.
#
# The tools disagree by default — check_scramble.mjs reads $URL and defaults to
# 4173, the others read $SHOOT_URL and default to 4174 — and a preview server
# left over from another session takes whichever it finds free, so a gate can
# silently measure a DIFFERENT build than the one about to ship. Pinning it and
# exporting both names removes the guess. --strictPort makes a clash an error
# rather than a quiet reassignment.
PORT=4183
BASE="http://localhost:$PORT"

QUICK=0
PREVIEW=0
ASSUME_YES=0
GATES_ONLY=0

for arg in "$@"; do
  case "$arg" in
    --quick)      QUICK=1 ;;
    --preview)    PREVIEW=1 ;;
    --yes|-y)     ASSUME_YES=1 ;;
    --gates-only) GATES_ONLY=1 ;;
    # The header block IS the help, so the two cannot drift apart: print the
    # comment lines from line 3 and stop at the first line that is not one.
    -h|--help)    awk 'NR>=3 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "ship: unknown option '$arg' (try --help)" >&2; exit 1 ;;
  esac
done

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
fail() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
ok()   { printf '\033[32m✓ %s\033[0m\n' "$*"; }

PREVIEW_PID=""

# Kill the whole process GROUP, not the pid.
#
# `npm run preview` is a shell that spawns vite as a child. Killing the npm pid
# reaps npm and orphans vite, which keeps the port bound — verified: after a
# clean run the script had exited and :4183 was still LISTEN on a stray node.
# The next run would then die on --strictPort, or worse, a later run would
# measure the server this one left behind. `setsid` below makes the npm process
# a group leader (so PGID == PID) and the negative pid kills everything in it.
cleanup() {
  [[ -n "$PREVIEW_PID" ]] || return 0
  kill -- "-$PREVIEW_PID" 2>/dev/null || kill "$PREVIEW_PID" 2>/dev/null || true
  wait "$PREVIEW_PID" 2>/dev/null || true
  PREVIEW_PID=""
}
trap cleanup EXIT INT TERM

cd "$APP"

# --- what is about to ship -------------------------------------------------

SHA="$(git rev-parse --short HEAD)"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
DIRTY="$(git status --porcelain)"

bold "Shipping $BRANCH @ $SHA"

if [[ -n "$DIRTY" ]]; then
  # A warning, not a refusal: this deploys the working tree, so uncommitted work
  # DOES go live. Worth seeing before it does, not worth blocking on — the
  # repo routinely carries an unrelated modified file from a parallel session.
  printf '\033[33m! uncommitted changes — these WILL be deployed:\033[0m\n'
  echo "$DIRTY" | sed 's/^/    /'
fi

if ! git diff --quiet HEAD "@{u}" 2>/dev/null; then
  printf '\033[33m! HEAD differs from its upstream — the live site will not match the remote\033[0m\n'
fi

# --- gates -----------------------------------------------------------------

bold "Unit tests and types"
npm test
npx tsc -b
ok "tests and types"

bold "Build"
npm run build
ok "build"

if [[ "$QUICK" -eq 1 ]]; then
  printf '\033[33m! --quick: browser gates skipped (motion, contrast, stations, scramble, csp)\033[0m\n'
else
  bold "Browser gates on :$PORT"
  setsid npm run preview -- --port "$PORT" --strictPort >/tmp/ship-preview.log 2>&1 &
  PREVIEW_PID=$!

  for _ in $(seq 1 40); do
    if curl -fsS -o /dev/null "$BASE/"; then break; fi
    if ! kill -0 "$PREVIEW_PID" 2>/dev/null; then
      cat /tmp/ship-preview.log >&2
      fail "preview server exited before it served anything"
    fi
    sleep 0.25
  done
  curl -fsS -o /dev/null "$BASE/" || { cat /tmp/ship-preview.log >&2; fail "preview never came up on $BASE"; }

  # Both names, because the tools disagree about which one they read.
  export SHOOT_URL="$BASE/"
  export URL="$BASE"

  npm run check:motion
  npm run check:contrast
  npm run check:stations
  npm run check:scramble
  # Serves dist/ through vercel.json's real headers on a port of its own, so it
  # needs no preview and must run regardless.
  npm run check:csp

  cleanup
  # Prove it: a bound port here means the next run dies on --strictPort.
  if command -v ss >/dev/null && ss -ltn 2>/dev/null | grep -q ":$PORT "; then
    fail "preview server survived cleanup and is still bound to :$PORT"
  fi
  ok "browser gates"
fi

# The corpus is committed and the serverless function does no I/O, so a stale
# one ships silently. Rebuilding it must be a no-op; if it is not, src/content/
# changed without `npm run persona` and the bot is about to disagree with the
# page.
bold "Chat corpus"
npm run persona >/dev/null
if ! git diff --quiet -- api/_core/corpus.generated.json; then
  fail "corpus.generated.json is stale — 'npm run persona' changed it. Commit the rebuild, then ship."
fi
ok "corpus matches src/content/"

if [[ "$GATES_ONLY" -eq 1 ]]; then
  bold "--gates-only: everything passed, nothing deployed"
  exit 0
fi

# --- deploy ----------------------------------------------------------------

if [[ "$ASSUME_YES" -ne 1 ]]; then
  target="production"; [[ "$PREVIEW" -eq 1 ]] && target="a preview URL"
  read -r -p "Deploy $BRANCH @ $SHA to $target? [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]] || fail "not deployed"
fi

bold "Deploying"
# --prod is the only difference between a preview and the live site. The project
# is already linked (frontend/.vercel/project.json -> moeezahmadkhan-com), so
# this needs no --scope or --name.
if [[ "$PREVIEW" -eq 1 ]]; then
  npx vercel
else
  npx vercel --prod
fi

ok "deployed $BRANCH @ $SHA"
echo
echo "OPENROUTER_API_KEY must be set as a Vercel project env var for /api/chat;"
echo "without it the chat returns its fallback reply. It is never read from here."
